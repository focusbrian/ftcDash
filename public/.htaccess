# Apache hosting (cPanel, InMotion shared/VPS). Vite copies this into dist/ untouched, so
# uploading the build is all a host needs. Harmless on hosts that ignore it.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Vite fingerprints every file in assets/ with a content hash, so they never change under the
# same name. index.html does, and must not be cached or a new deploy goes unnoticed.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|shared-assets\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(index\.html|shared-assets\.json)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
